{
  "name": "zjpcy-workflow",
  "version": "1.0.0",
  "description": "React component library with Next.js for development and Rollup for publishing",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:lib": "rollup -c rollup.config.js",
    "build:lib:watch": "rollup -c rollup.config.js --watch",
    "dev": "webpack serve --config webpack.config.js",
    "build:webpack": "webpack --config webpack.config.js --mode=production",
    "dev:examples": "webpack serve --config webpack.examples.config.js",
    "build:examples": "webpack --config webpack.examples.config.js --mode=production"
  },
  "keywords": [
    "react",
    "component-library",
    "nextjs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@uiw/react-codemirror": "^4.25.8",
    "@zjpcy/simple-design": "^1.8.4",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^6.10.0",
    "dotenv": "^16.6.1",
    "html-webpack-plugin": "^5.6.0",
    "next": "^14.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rollup": "^4.12.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "style-loader": "^3.3.4",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  },
  "dependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  }
}
